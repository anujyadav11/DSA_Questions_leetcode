Optimal Solution - Reconstructs binary tree using preorder root selection and inorder partitioning with hashmap optimization.
                   Preorder tells you the root, inorder tells you subtree boundaries — combine both using divide and conquer.

class Solution {
    public TreeNode buildTree(int[] preorder, int[] inorder) {
        // Map to store value -> index in inorder array
        // This allows O(1) lookup for subtree splitting
        Map<Integer, Integer> inOrderMap = new HashMap<>();
        for (int i = 0; i < inorder.length; i++) {
            inOrderMap.put(inorder[i], i);
        }
        // Start recursion:
        // rootIdx = 0 (first element of preorder)
        // left = 0, right = inorder.length - 1 (full inorder range)
        return splitTree(preorder, inOrderMap, 0, 0, inorder.length - 1);
    }
    private TreeNode splitTree(int[] preorder,
                               Map<Integer, Integer> inOrderMap,
                               int rootIdx,
                               int left,
                               int right) {
        // Create root node from preorder
        TreeNode root = new TreeNode(preorder[rootIdx]);
        // Find root index in inorder traversal
        int mid = inOrderMap.get(preorder[rootIdx]);
        // If there are elements on left side in inorder,
        // build left subtree
        if (mid > left) {
            // Next preorder root is rootIdx + 1
            root.left = splitTree(
                    preorder,
                    inOrderMap,
                    rootIdx + 1,
                    left,
                    mid - 1
            );
        }
        // If there are elements on right side in inorder,
        // build right subtree
        if (mid < right) {
            // Calculate correct preorder index for right subtree root
            root.right = splitTree(
                    preorder,
                    inOrderMap,
                    rootIdx + mid - left + 1,
                    mid + 1,
                    right
            );
        }
        return root;
    }
}

Time Complexity :- O(n).
Space Complexity :- O(n).
