Optimal Solution - LRU Cache implemented using HashMap and Doubly Linked List for O(1) get and put operations.
                   HashMap gives O(1) access, doubly linked list maintains LRU order — combine both to achieve constant time operations.

class LRUCache {
    // Dummy head and tail nodes to simplify insert/remove operations
    Node head = new Node(0, 0), tail = new Node(0, 0);
    // HashMap to store key -> Node reference
    Map<Integer, Node> map = new HashMap<>();
    // Maximum capacity of cache
    int _capacity;
    public LRUCache(int capacity) {
        _capacity = capacity;
        // Initialize empty doubly linked list
        head.next = tail;
        tail.prev = head;
    }
    public int get(int key) {
        // If key exists
        if (map.containsKey(key)) {
            Node node = map.get(key);
            // Move accessed node to front (most recently used)
            remove(node);
            insert(node);
            return node.value;
        }
        // If key not found
        return -1;
    }
    public void put(int key, int value) {
        // If key already exists, remove old node
        if (map.containsKey(key)) {
            remove(map.get(key));
        }
        // If capacity reached, remove least recently used node
        if (map.size() == _capacity) {
            remove(tail.prev); // LRU node is before tail
        }
        // Insert new node at front (MRU position)
        insert(new Node(key, value));
    }
    // Remove node from doubly linked list and map
    private void remove(Node node) {
        map.remove(node.key);
        node.prev.next = node.next;
        node.next.prev = node.prev;
    }
    // Insert node right after head (most recently used)
    private void insert(Node node) {
        map.put(node.key, node);
        Node headNext = head.next;
        head.next = node;
        node.prev = head;
        node.next = headNext;
        headNext.prev = node;
    }
    // Doubly linked list node
    class Node {
        Node prev, next;
        int key, value;
        Node(int _key, int _value) {
            key = _key;
            value = _value;
        }
    }
}

Time Complexity :- O(1).
Space Complexity :- O(capacity).
