Optimal Solution - Use Union-Find with path compression to detect the redundant edge that forms a cycle.
                  If two nodes already belong to the same set, adding that edge forms a cycle, making it redundant.

class Solution {
    // parent[i] stores the parent of node (i + 1)
    int parent[];
    public int[] findRedundantConnection(int[][] edges) {
        // Initialize parent array
        // Nodes are labeled from 1 to n
        parent = new int[edges.length];
        for (int i = 0; i < edges.length; i++) {
            parent[i] = i + 1;
        }
        // Process each edge
        for (int[] edge : edges) {
            // If both nodes have the same root, edge is redundant
            if (find(edge[0]) == find(edge[1])) {
                return edge;
            } else {
                // Otherwise, union the two sets
                union(edge[0], edge[1]);
            }
        }
        // Should never reach here per problem constraints
        return new int[2];
    }
    // Find operation with path compression
    public int find(int x) {
        // If x is its own parent, return it
        if (x == parent[x - 1])
            return x;
        // Path compression
        parent[x - 1] = find(parent[x - 1]);
        return parent[x - 1];
    }
    // Union operation
    public void union(int x, int y) {
        // Attach root of y to root of x
        parent[find(y) - 1] = find(x);
    }
}

Time Complexity :- O(n).
Space Complexity :- O(n).
