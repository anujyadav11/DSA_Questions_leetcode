Optimal Solution - Use DFS from each rotten orange to compute the minimum time required to rot all fresh oranges.
                    Since all rotten oranges spread simultaneously, BFS naturally models level-by-level time propagation, while DFS may cause redundant traversals.

class Solution {
    public int orangesRotting(int[][] grid) {
        // Edge case: empty grid
        if (grid == null || grid.length == 0)
            return -1;
        int row = grid.length, col = grid[0].length;
        // time[i][j] stores the minimum time required to rot cell (i, j)
        int[][] time = new int[row][col];
        // Initialize all times to infinity
        for (int i = 0; i < row; i++) {
            Arrays.fill(time[i], Integer.MAX_VALUE);
        }
        // Start DFS from every initially rotten orange
        for (int i = 0; i < row; i++) {
            for (int j = 0; j < col; j++) {
                if (grid[i][j] == 2) {
                    dfs(grid, time, i, j, 0);
                }
            }
        }
        int timeReq = 0;
        // Check if any fresh orange is unreachable
        // Also track the maximum time required
        for (int i = 0; i < row; i++) {
            for (int j = 0; j < col; j++) {
                if (grid[i][j] == 1) {
                    // Fresh orange never rotted
                    if (time[i][j] == Integer.MAX_VALUE)
                        return -1;
                    timeReq = Math.max(timeReq, time[i][j]);
                }
            }
        }
        return timeReq;
    }
    // DFS to propagate rotting effect
    public void dfs(int[][] grid, int[][] time, int i, int j, int currTime) {
        // Boundary checks, empty cell, or worse time already found
        if (i < 0 || j < 0 || i >= grid.length || j >= grid[0].length
                || grid[i][j] == 0
                || currTime >= time[i][j])
            return;
        // Update minimum time to rot this cell
        time[i][j] = currTime;
        // Spread rot in all 4 directions
        dfs(grid, time, i + 1, j, currTime + 1);
        dfs(grid, time, i - 1, j, currTime + 1);
        dfs(grid, time, i, j + 1, currTime + 1);
        dfs(grid, time, i, j - 1, currTime + 1);
    }
}

Time Complexity :- O((R x C)^2).
Space Complexity :- O(R x C).
