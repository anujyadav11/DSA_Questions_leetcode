Optimal Solution - Use a max-heap of size k to keep the k closest points to the origin based on squared Euclidean distance.

class Solution {
    public int[][] kClosest(int[][] points, int k) {
        // Max-heap based on squared distance from origin
        // We keep the k closest points, so the farthest among them stays on top
        PriorityQueue<int[]> maxHeap = new PriorityQueue<>(
            (a, b) -> Integer.compare(
                b[0] * b[0] + b[1] * b[1],  // distance of point b
                a[0] * a[0] + a[1] * a[1]   // distance of point a
            )
        );
        // Process each point
        for (int[] point : points) {
            // Add current point to heap
            maxHeap.offer(point);
            // If heap size exceeds k, remove the farthest point
            if (maxHeap.size() > k) {
                maxHeap.poll();
            }
        }
        // Extract k closest points from the heap
        int[][] res = new int[k][2];
        for (int i = 0; i < k; i++) {
            res[i] = maxHeap.poll();
        }
        return res;
    }
}

Time Complexity :- O(n log k).
Space Complexity :- O(k).
