/*********************************************** JAVA **************************************************/

Optimal Solution - Solve the circular House Robber problem by converting it into two linear robberies: skipping the first house or skipping the last house.

class Solution {
    public int rob(int[] nums) {
        // Edge case: only one house
        if (nums.length == 1)  return nums[0];
        // Create two arrays:
        // 1) skipLastHouse → consider houses [0 ... n-2]
        // 2) skipFirstHouse → consider houses [1 ... n-1]
        int[] skipLastHouse = new int[nums.length - 1];
        int[] skipFirstHouse = new int[nums.length - 1];
        for (int i = 0; i < nums.length - 1; i++) {
            skipLastHouse[i] = nums[i];
            skipFirstHouse[i] = nums[i + 1];
        }
        // Solve both linear house robber cases
        int lootSkippingLast = robHelper(skipLastHouse);
        int lootSkippingFirst = robHelper(skipFirstHouse);
        // Return the maximum loot possible
        return Math.max(lootSkippingLast, lootSkippingFirst);
    }
    // Standard House Robber DP for linear houses
    private int robHelper(int[] nums) {
        // If only one house exists
        if (nums.length == 1) return nums[0];
        // dp[i] = maximum loot from houses [0..i]
        int[] dp = new int[nums.length];
        // Base cases
        dp[0] = nums[0];
        dp[1] = Math.max(nums[0], nums[1]);
        // Fill the DP table
        for (int i = 2; i < nums.length; i++) {
            dp[i] = Math.max(
                dp[i - 2] + nums[i], // rob current house
                dp[i - 1]            // skip current house
            );
        }
        // Maximum loot is stored at the last index
        return dp[nums.length - 1];
    }
}

Time Complexity :- O(N).
Space Complexity :- O(N).
