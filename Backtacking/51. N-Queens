Optimal Solution - Classic backtracking solution for N-Queens placing queens column-wise with diagonal conflict pruning.
                   Place one queen per column and backtrack whenever a placement violates row or diagonal constraints.

class Solution {
    // This method finds all solutions to the N-Queens problem.
    public static List<List<String>> solveNQueens(int n) {
        // Create a chessboard of size n x n and initialize it with '.' (empty) squares.
        char[][] board = new char[n][n];
        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++)
                board[i][j] = '.';
        // Create a list to store the results.
        List<List<String>> res = new ArrayList<List<String>>();
        // Start the depth-first search to find solutions.
        dfs(0, board, res);
        // Return the list of solutions.
        return res;
    }
    // This method checks if it's valid to place a queen at the given position.
    static boolean validate(char[][] board, int row, int col) {
        int duprow = row;
        int dupcol = col;
        // Check for queens in the same column above the current row.
        while (row >= 0 && col >= 0) {
            if (board[row][col] == 'Q') return false;
            row--;
            col--;
        }
        // Reset row and col to their original values.
        row = duprow;
        col = dupcol;     
        // Check for queens in the same row to the left.
        while (col >= 0) {
            if (board[row][col] == 'Q') return false;
            col--;
        }      
        // Reset row and col to their original values.
        row = duprow;
        col = dupcol;  
        // Check for queens in the diagonal to the left and above.
        while (col >= 0 && row < board.length) {
            if (board[row][col] == 'Q') return false;
            col--;
            row++;
        }
        // If no conflicts were found, it's valid to place a queen at this position.
        return true;
    }
    // This is a recursive method for the depth-first search to find solutions.
    static void dfs(int col, char[][] board, List<List<String>> res) {
        // If we've placed queens in all columns, we've found a solution.
        if (col == board.length) {
            res.add(construct(board)); // Add the solution to the results.
            return;
        }
        // Try placing a queen in each row of the current column.
        for (int row = 0; row < board.length; row++) {
            if (validate(board, row, col)) { // Check if it's a valid position.
                board[row][col] = 'Q'; // Place the queen.
                dfs(col + 1, board, res); // Recur to the next column.
                board[row][col] = '.'; // Backtrack by removing the queen.
            }
        }
    }
    // This method constructs a list of strings representing the board state.
    static List<String> construct(char[][] board) {
        List<String> res = new LinkedList<String>();
        for (int i = 0; i < board.length; i++) {
            String s = new String(board[i]);
            res.add(s);
        }
        return res;
    }
}

Time Complexity :- O(N! × N).
Space Complexity :- O(N²).
