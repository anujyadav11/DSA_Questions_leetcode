Optimal Solution - Binary search on time combined with DFS reachability to find the earliest moment a path exists.
                   The earliest time must satisfy a monotonic reachability condition, making binary search + DFS an optimal solution.

class Solution {
    int[][] dirs = {{0, 1}, {0, -1}, {1, 0}, {-1, 0}};
    int n;
    public boolean possibleToReach(int[][] grid, int i, int j, int t, boolean[][] vis) {
        // Boundary, visited, and height check
        if (i < 0 || j < 0 || i >= n || j >= n || vis[i][j] || grid[i][j] > t) {
            return false;
        }
        // Reached destination
        if (i == n - 1 && j == n - 1) {
            return true;
        }
        // Mark current cell as visited
        vis[i][j] = true;
        // Explore all 4 directions
        for (int[] dir : dirs) {
            int newi = i + dir[0];
            int newj = j + dir[1];
            if (possibleToReach(grid, newi, newj, t, vis)) {
                return true;
            }
        }
        return false;
    }
    public int swimInWater(int[][] grid) {
        n = grid.length;
        // Binary search range
        int l = grid[0][0];
        int r = n * n - 1;
        int res = 0;
        // Binary search on time
        while (l <= r) {
            int mid = l + (r - l) / 2;
            boolean[][] vis = new boolean[n][n];
            // Check if reachable at time = mid
            if (possibleToReach(grid, 0, 0, mid, vis)) {
                res = mid;
                r = mid - 1;
            } else {
                l = mid + 1;
            }
        }
        return res;
    }
}

Time Complexity :- O(N^2 log N).
Space Complexity :- O(N^2).

Dijkstra Alogrithm Solution

class Solution {
    // Directions to move: down, up, right, left
    int[][] directions = {{1, 0}, {-1, 0}, {0, 1}, {0, -1}};
    public int swimInWater(int[][] grid) {
        int n = grid.length;
        // result[i][j] stores the minimum time needed to reach cell (i, j)
        int[][] result = new int[n][n];
        for (int[] row : result)
            Arrays.fill(row, Integer.MAX_VALUE);
        // Min-heap prioritizing the cell with the smallest current time
        PriorityQueue<int[]> pq =
                new PriorityQueue<>((a, b) -> a[0] - b[0]);
        // Start from the top-left cell
        result[0][0] = grid[0][0];
        pq.offer(new int[]{grid[0][0], 0, 0}); // {time, row, col}
        // Dijkstra-style traversal
        while (!pq.isEmpty()) {
            int[] curr = pq.poll();
            int currTime = curr[0];
            int i = curr[1];
            int j = curr[2];
            // If destination is reached, this is the minimum possible time
            if (i == n - 1 && j == n - 1)
                return currTime;
            // Skip outdated entries
            if (currTime > result[i][j])
                continue;
            // Explore all 4 neighboring cells
            for (int[] dir : directions) {
                int i_ = i + dir[0];
                int j_ = j + dir[1];
                // Boundary check
                if (i_ >= 0 && i_ < n && j_ >= 0 && j_ < n) {
                    // Time to enter the next cell
                    int nextTime = Math.max(currTime, grid[i_][j_]);
                    // Relax the edge if a better time is found
                    if (nextTime < result[i_][j_]) {
                        result[i_][j_] = nextTime;
                        pq.offer(new int[]{nextTime, i_, j_});
                    }
                }
            }
        }
        // Problem guarantees reachability
        return -1;
    }
}
Time Complexity :- O(N^2 log N).
Space Complexity :- O(N^2).

